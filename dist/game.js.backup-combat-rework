        state.locationProgress[locId] = 0;
        saveGame();
        // Sumarizace lootu
        let totalLootGold = 0;
        const lootItems = [];
        (state._floorLootDrops || []).forEach(d => {
          if (d.type === 'gold') totalLootGold += d.gold;
          else if (d.type === 'item') { lootItems.push(d.item); }
